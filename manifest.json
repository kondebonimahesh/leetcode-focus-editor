{
  "manifest_version": 3,
  "name": "LeetCode Focus Editor",
  "version": "1.0",
  "description": "Press Alt+C to focus the LeetCode code editor.",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
